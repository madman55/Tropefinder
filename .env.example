# Copy this file to .env and fill in the values. .env is git-ignored.
# NEVER put real values in this file or anywhere else in the repo.

# Supabase: Project Settings -> API
SUPABASE_URL=
# The secret (service_role) key. Server-side only: Python jobs and GitHub Secrets.
SUPABASE_SECRET_KEY=

# Open Library asks apps to identify themselves. Use your own contact email.
OPENLIBRARY_USER_AGENT="TropeFinder/0.1 (your-email@example.com)"

# Hardcover: hardcover.app -> Settings -> API. Paste the whole value it gives you.
HARDCOVER_TOKEN=

# Anthropic (Claude Haiku classifier): console.anthropic.com -> API keys. Needed from Stage 6.
ANTHROPIC_API_KEY=
